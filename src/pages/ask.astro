---
import Base from '../layouts/Base.astro';
import AskBox from '../components/AskBox.astro';
---

<Base title="Ask" description="Ask a question in plain English and get recipe suggestions.">
  <div class="narrow">
    <h1>Ask the kitchen</h1>
    <p class="muted">
      Tell me what you have, how much time you've got, or what you're in the mood for, and I'll point you to recipes from
      this site. Answers are generated by AI from my recipes, so double-check anything important like allergens.
    </p>
    <AskBox />
  </div>
</Base>
